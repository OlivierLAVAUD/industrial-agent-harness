# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=industrialneo4j

# LLM (optionnel : sans clé, le PoC utilise un modèle scripté qui reproduit le
# function calling pour une démonstration hors-ligne déterministe).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Identité simulée de l'approbateur humain.
APPROVER_ID=supervisor-demo

# Clé HMAC du registre d'audit. Exemple de développement uniquement :
# régénérez-la en production avec `python -c "import secrets; print(secrets.token_hex(32))"`.
AUDIT_HMAC_KEY=2201506095efc4c92795418c690067e00cc9e801615e323d09d61648b085ab52
AUDIT_LOG_PATH=var/audit_chain.jsonl

# streamlit (défaut) | cli | auto_approve | auto_reject
APPROVAL_MODE=streamlit
APPROVAL_TIMEOUT_SECONDS=600

# Intégration Preloop réelle (optionnelle). Si PRELOOP_URL et PRELOOP_TOKEN sont
# renseignés, les outils sont enveloppés par langchain-preloop.
PRELOOP_URL=
PRELOOP_TOKEN=
